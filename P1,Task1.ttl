@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html> .

<https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html> rdf:type owl:Ontology ;
                                                                           owl:imports <file:///C:/Users/Mahdi/Desktop/Inf230/P1_Task2.ttl> .

#################################################################
#    Object Properties
#################################################################

###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#endStation
:endStation rdf:type owl:ObjectProperty ;
            rdfs:domain :TrainTrip ;
            rdfs:range :TrainStation .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#isRunBy
:isRunBy rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :usesEquipment ;
         owl:inverseOf :runs ;
         rdfs:domain :Service ;
         rdfs:range :Equipment .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#runs
:runs rdf:type owl:ObjectProperty .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#startStation
:startStation rdf:type owl:ObjectProperty ;
              rdfs:domain :TrainTrip ;
              rdfs:range :TrainStation .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#usesEquipment
:usesEquipment rdf:type owl:ObjectProperty ;
               rdfs:domain :Service ;
               rdfs:range :Equipment .


#################################################################
#    Classes
#################################################################

###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#Equipment
:Equipment rdf:type owl:Class .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#Service
:Service rdf:type owl:Class .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#Train
:Train rdf:type owl:Class ;
       rdfs:subClassOf :Equipment .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#TrainStation
:TrainStation rdf:type owl:Class .


###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#TrainTrip
:TrainTrip rdf:type owl:Class ;
           rdfs:subClassOf :Service ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :endStation ;
                             owl:someValuesFrom :TrainStation
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isRunBy ;
                             owl:someValuesFrom :Train
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :startStation ;
                             owl:someValuesFrom :TrainStation
                           ] .


#################################################################
#    Individuals
#################################################################

###  https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-problem-1.html#Train2
:Train2 rdf:type owl:NamedIndividual ,
                 :Equipment ;
        :runs :Trip1 .


#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :Equipment
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :runs ;
                         owl:someValuesFrom :TrainTrip
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :Train
] .


