@base <https://home.bawue.de/~horsch/teaching/inf230/lab/data#>.

@prefix owl:     <http://www.w3.org/2002/07/owl#>.
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos:    <http://www.w3.org/2004/02/skos/core#>.
@prefix xs:      <http://www.w3.org/2001/XMLSchema#>.
@prefix dcat:    <http://www.w3.org/ns/dcat#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dol:     <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#>.
@prefix schema:  <http://schema.org/>.
@prefix mso-em:  <https://www.purl.org/mso-em#>.
@prefix ex:      <https://home.bawue.de/~horsch/teaching/inf230/lab/tbox#>.

<> a owl:Ontology;
   dcterms:title "Train Service Ontology"@en;
   dcterms:issued "2026-09-16"^^dcterms:W3CDTF;
   dcterms:license <https://creativecommons.org/licenses/by-nc-sa/4.0/>;
   dcterms:creator <#Oswa>, <#Ilwaad>
# --- TBox: Klasser ---

ex:Service a owl:Class ;
    rdfs:label "Service"@en .

ex:TrainJourney a owl:Class ;
    rdfs:subClassOf ex:Service ;
    rdfs:label "Train Journey"@en .

ex:Equipment a owl:Class ;
    rdfs:label "Equipment"@en .

ex:Train a owl:Class ;
    rdfs:subClassOf ex:Equipment ;
    rdfs:label "Train"@en .

ex:Station a owl:Class ;
    rdfs:label "Station"@en .

ex:Coach a owl:Class ;
    rdfs:subClassOf ex:Equipment ;
    rdfs:label "Coach"@en .

# --- TBox: Egenskaper ---

ex:hasStartStation a owl:ObjectProperty ;
    rdfs:domain ex:TrainJourney ;
    rdfs:range  ex:Station .

ex:hasEndStation a owl:ObjectProperty ;
    rdfs:domain ex:TrainJourney ;
    rdfs:range  ex:Station .

ex:departureTime a owl:DatatypeProperty ;
    rdfs:domain ex:TrainJourney ;
    rdfs:range  xs:dateTime .

ex:arrivalTime a owl:DatatypeProperty ;
    rdfs:domain ex:TrainJourney ;
    rdfs:range  xs:dateTime .

ex:operatedBy a owl:ObjectProperty ;
    rdfs:domain ex:TrainJourney ;
    rdfs:range  ex:Train .

ex:hasCoach a owl:ObjectProperty ;
    rdfs:domain ex:Train ;
    rdfs:range  ex:Coach .